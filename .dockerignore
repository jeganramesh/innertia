# Ignore everything from gitignore first
.git
.gitignore
.dockerignore

# Node.js specific ignores
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json # If not needed in the final image, often copied separately
npm-debug.log
npm-shrinkwrap.json

# Python specific ignores
__pycache__
*.pyc
*.pyo
*.pyd
.Python
.venv

# Build and temp directories
dist
build
tmp
*.log

# Editor/IDE specific files
.vscode
.idea
*.sublime-project
*.sublime-workspace

# Environment files
.env
.env.*

# Database files
*.db

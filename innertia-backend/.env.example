# Innertia Placement Shell - Environment Variables

# Application
APP_NAME="Innertia Placement Shell"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Security
# IMPORTANT: Change this in production!
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://innertia:innertia123@postgres:5432/innertia_placement
SYNC_DATABASE_URL=postgresql://innertia:innertia123@postgres:5432/innertia_placement

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
